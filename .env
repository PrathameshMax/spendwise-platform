# Which image of each SpendWise service this environment runs.
# docker compose reads this file automatically. `main` = the latest build of
# that repository's main branch; pin a commit SHA (the tag CI pushes with every
# build) to run an exact, reproducible version, e.g.
#   USER_SERVICE_TAG=4f2c9e1a7b3d5e6f8091a2b3c4d5e6f708192a3b
DISCOVERY_SERVER_TAG=main
CONFIG_SERVER_TAG=main
USER_SERVICE_TAG=main
TRANSACTION_SERVICE_TAG=main
BUDGET_SERVICE_TAG=main
NOTIFICATION_SERVICE_TAG=main
ANALYTICS_SERVICE_TAG=main
API_GATEWAY_TAG=main
WEB_TAG=main
